<?xml version="1.0" encoding="UTF-8"?>
<!--
  Integration test: downloads a real file from S3.
  Only runs when the 'aws-it' profile is active (pass -Daws.it.bucket=...).
  Used in GitHub Actions E2E and for local testing with real AWS credentials.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.yourcompany.maven.it</groupId>
    <artifactId>aws-download</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <description>
        Downloads a real object from S3 and verifies it was written to target/classes.
        Requires: -Daws.it.bucket, -Daws.it.key, -Daws.it.region
    </description>

    <properties>
        <aws.it.bucket>${aws.it.bucket}</aws.it.bucket>
        <aws.it.key>${aws.it.key}</aws.it.key>
        <aws.it.region>${aws.it.region}</aws.it.region>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.yourcompany.maven</groupId>
                <artifactId>aws-tls-injector-maven-plugin</artifactId>
                <version>@project.version@</version>
                <executions>
                    <execution>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>fetch-tls-context</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <region>${aws.it.region}</region>
                    <failOnMissingFile>true</failOnMissingFile>
                    <files>
                        <file>
                            <bucket>${aws.it.bucket}</bucket>
                            <key>${aws.it.key}</key>
                            <targetFileName>certificates/test-keystore.jks</targetFileName>
                        </file>
                    </files>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
