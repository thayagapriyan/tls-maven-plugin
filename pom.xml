<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- groupId = Anypoint org/business-group GUID, so the asset publishes to and resolves
         from Exchange under these exact coordinates (Java package stays com.priyan.maven). -->
    <groupId>3075da4c-6c1a-46d3-984a-191b16b7e34e</groupId>
    <artifactId>aws-tls-injector-maven-plugin</artifactId>
    <version>1.0.5</version>
    <packaging>maven-plugin</packaging>

    <name>AWS S3 TLS Context Injector Maven Plugin</name>
    <description>
        Fetches TLS keystore/truststore files from an AWS S3 bucket at build time and writes
        them into the Maven build output directory, so certificates never get committed to VCS.
    </description>

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.version>3.9.6</maven.version>
        <maven.plugin.tools.version>3.13.1</maven.plugin.tools.version>
        <aws.sdk.version>2.28.16</aws.sdk.version>
        <junit.version>5.10.2</junit.version>
        <mockito.version>5.11.0</mockito.version>

        <!-- Anypoint Exchange publishes this as a custom asset (see the exchange-release
             profile). exchange-mule-maven-plugin reads <type> to set the asset classifier. -->
        <type>custom</type>
        <exchange.mule.maven.plugin.version>0.1.7</exchange.mule.maven.plugin.version>

        <!-- Org/business-group GUID = Exchange repo path. Defined at top level so the
             always-active <repositories> URL resolves in every build; the exchange-release
             profile can still override it via -Danypoint.orgId. -->
        <anypoint.orgId>3075da4c-6c1a-46d3-984a-191b16b7e34e</anypoint.orgId>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Maven plugin API -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven.plugin.tools.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- AWS SDK v2 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven.plugin.tools.version}</version>
                <configuration>
                    <goalPrefix>tls</goalPrefix>
                </configuration>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>help-goal</id>
                        <goals>
                            <goal>helpmojo</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <settingsFile>src/it/settings.xml</settingsFile>
                    <localRepositoryPath>${project.build.directory}/local-repo</localRepositoryPath>
                    <postBuildHookScript>verify</postBuildHookScript>
                    <!-- aws-download needs a real/LocalStack bucket; it only runs under
                         the aws-it profile (activated by -Daws.it.bucket). -->
                    <pomExcludes>
                        <pomExclude>aws-download/pom.xml</pomExclude>
                    </pomExcludes>
                    <goals>
                        <goal>clean</goal>
                        <goal>generate-resources</goal>
                    </goals>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Profile for running integration tests against real AWS -->
        <profile>
            <id>aws-it</id>
            <activation>
                <property>
                    <name>aws.it.bucket</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-invoker-plugin</artifactId>
                        <configuration>
                            <!-- Clear the default exclude so aws-download runs here. -->
                            <pomExcludes combine.self="override"/>
                            <pomIncludes>
                                <pomInclude>aws-download/pom.xml</pomInclude>
                            </pomIncludes>
                            <properties>
                                <aws.it.bucket>${aws.it.bucket}</aws.it.bucket>
                                <aws.it.key>${aws.it.key}</aws.it.key>
                                <aws.it.region>${aws.it.region}</aws.it.region>
                            </properties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Publishing to Anypoint Exchange.

          IMPORTANT: Exchange stores every asset under groupId = your organization
          (business group) ID. This plugin's groupId is 'com.priyan.maven', so before
          a real Exchange publish you must republish it under the org GUID — set
          -Dexchange.groupId / change <groupId> to the org id, or deploy with
          deploy-file using the org-id coordinates. The org id also forms the repo URL.

          Activate with: mvn -Pexchange-release deploy
          Requires a <server id="anypoint-exchange-v3"> (connected app) in settings.xml.
        -->
        <profile>
            <id>exchange-release</id>
            <properties>
                <anypoint.orgId>3075da4c-6c1a-46d3-984a-191b16b7e34e</anypoint.orgId>
            </properties>
            <distributionManagement>
                <repository>
                    <id>anypoint-exchange-v3</id>
                    <name>Anypoint Exchange</name>
                    <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${anypoint.orgId}/maven</url>
                </repository>
            </distributionManagement>
            <build>
                <plugins>
                    <!--
                      Exchange v3 custom-asset publish (per MuleSoft's custom-asset sample).
                      The facade rejects a plain maven-deploy PUT (HTTP 412); it requires
                      exchange-pre-deploy to register the asset/version first, then
                      exchange-deploy uploads. <type>custom</type> + <inherited>false</inherited>
                      are mandatory for the handshake.

                      Scoped to this profile so ordinary CI (test/verify) never invokes it and
                      never needs Exchange credentials.
                    -->
                    <plugin>
                        <groupId>org.mule.tools.maven</groupId>
                        <artifactId>exchange-mule-maven-plugin</artifactId>
                        <version>${exchange.mule.maven.plugin.version}</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>validate</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exchange-pre-deploy</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>deploy</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>exchange-deploy</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- exchange-deploy uploads the asset file; attach the built plugin JAR
                         under classifier=custom so it rides along as the custom asset's
                         artifact (the JAR is still a fully usable maven-plugin). -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-custom-classifier</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>${type}</classifier>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- The Exchange facade is incompatible with the stock maven-deploy-plugin
                         (it 412s a plain PUT). exchange-deploy is the sole uploader. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
    <!-- id MUST equal the <server> id in settings.xml and the distributionManagement id
         (anypoint-exchange-v3). exchange-pre-deploy reads its generated preConditions-*.json
         back through THIS repository's credentials; an id mismatch makes that read
         unauthenticated -> "Artifact could not be resolved". URL is the org-scoped v3 endpoint
         so it also matches the runId/... base the plugin resolves against. -->
    <repository>
        <id>anypoint-exchange-v3</id>
        <name>Anypoint Exchange</name>
        <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${anypoint.orgId}/maven</url>
        <layout>default</layout>
    </repository>
    <repository>
        <id>mulesoft-releases</id>
        <name>MuleSoft Releases Repository</name>
        <url>https://repository.mulesoft.org/releases/</url>
        <layout>default</layout>
    </repository>
    <repository>
        <id>mulesoft-public</id>
        <name>MuleSoft Public Repository</name>
        <url>https://repository.mulesoft.org/nexus/content/repositories/public/</url>
        <layout>default</layout>
    </repository>
</repositories>
<pluginRepositories>
    <pluginRepository>
        <id>mulesoft-releases</id>
        <name>MuleSoft Releases Repository</name>
        <layout>default</layout>
        <url>https://repository.mulesoft.org/releases/</url>
        <snapshots>
            <enabled>false</enabled>
        </snapshots>
    </pluginRepository>
</pluginRepositories>
</project>
